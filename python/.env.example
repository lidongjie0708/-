AGENT_APP_NAME=BlogsLike Agent Service
AGENT_DEBUG=true
AGENT_CORS_ORIGINS=*

# Use the same base64 JWT_SECRET as the Java service so Python can verify short-lived AI tokens.
JWT_SECRET=
AI_TOKEN_REQUIRED=true

# Shared only between Java backend and Python Agent for internal write tasks such as RAG embedding.
INTERNAL_AGENT_TOKEN=
INTERNAL_AGENT_TOKEN_REQUIRED=true

# LLM. Leave OPENAI_API_KEY empty to use rule-based fallback responses.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2

# MySQL used by analytics.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=blogslike

# Redis is optional. The service keeps an in-memory task store if Redis is absent.
REDIS_URL=redis://localhost:6379/0

# RAG vector store.
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=blog_chunks

# DashScope embedding. Put the real key in local .env, never in git.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_TIMEOUT=30

# Qwen reranker. The user project can set DASHAPI as requested.
DASHAPI=
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_RERANK_MODEL=Qwen3-Reranker-4B
DASHSCOPE_RERANK_TIMEOUT=30

RAG_TOP_K=5
RAG_MIN_SCORE=0.15
RAG_VECTOR_TOP_K=15
RAG_BM25_TOP_K=15
RAG_RRF_K=60
RAG_RRF_CANDIDATE_TOP_K=40
RAG_RERANK_TOP_K=4
RAG_LONG_TERM_MEMORY_ENABLED=true
RAG_MEMORY_TURNS=6
RAG_MEMORY_SUMMARY_EVERY_TURNS=6
RAG_MEMORY_SUMMARY_MAX_CHARS=1600
RAG_MEMORY_SUMMARY_ASYNC_ENABLED=true
RAG_MEMORY_SUMMARY_WORKER_POLL_SECONDS=5
RAG_MEMORY_SUMMARY_WORKER_BATCH_SIZE=2
