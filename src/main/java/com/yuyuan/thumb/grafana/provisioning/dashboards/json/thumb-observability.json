      "targets": [{"expr": "sum(thumb_reconciliation_difference_pairs)", "refId": "A"}],
      "title": "Redis/MySQL differing pairs", 
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
