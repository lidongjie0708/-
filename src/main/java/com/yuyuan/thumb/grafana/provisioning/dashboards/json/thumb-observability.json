      "targets": [{"expr": "sum(rate(cache_gets_total{cache=\"thumbLocalCache\",result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{cache=\"thumbLocalCache\"}[5m])), 1)", "refId": "A"}],
      "title": "Caffeine hit rate (5m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(thumb_rabbitmq_queue_messages)", "refId": "A"}],
      "title": "RabbitMQ queued messages", 
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
