<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yuyuan.thumb.mapper.BlogMapper">

    <resultMap id="BaseResultMap" type="com.yuyuan.thumb.model.entity.Blog">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="coverImg" column="coverImg" jdbcType="VARCHAR"/>
            <result property="content" column="content" jdbcType="VARCHAR"/>
            <result property="contentFormat" column="content_format" jdbcType="VARCHAR"/>
            <result property="thumbCount" column="thumbCount" jdbcType="INTEGER"/>
            <result property="summary" column="summary" jdbcType="VARCHAR"/>
            <result property="tags" column="tags" jdbcType="VARCHAR"/>
            <result property="embeddingStatus" column="embedding_status" jdbcType="INTEGER"/>
            <result property="auditStatus" column="audit_status" jdbcType="INTEGER"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,title,coverImg,
        content,content_format,thumbCount,summary,tags,embedding_status,audit_status,createTime,updateTime
    </sql>
    <update id="batchUpdateThumbCount">
        UPDATE blog
        SET thumbCount = thumbCount + CASE id
        <foreach collection="countMap.entrySet()" item="value" index="key">
            WHEN #{key} THEN #{value}
        </foreach>
        END
        WHERE id IN
        <foreach collection="countMap.keySet()" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    <update id="refreshThumbCount">
        UPDATE blog
        SET thumbCount = (SELECT COUNT(*) FROM thumb WHERE blog_id = #{blogId})
        WHERE id = #{blogId}
    </update>
    <update id="refreshAllThumbCount">
        UPDATE blog b
        SET thumbCount = (SELECT COUNT(*) FROM thumb t WHERE t.blog_id = b.id)
    </update>
    <update id="incrementThumbCount">
        UPDATE blog SET thumbCount = thumbCount + 1 WHERE id = #{blogId}
    </update>
    <update id="decrementThumbCount">
        UPDATE blog SET thumbCount = GREATEST(thumbCount - 1, 0) WHERE id = #{blogId}
    </update>
</mapper>
